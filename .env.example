# ── MXDR Logging System — Environment Configuration ─────────────────────────

# LLM API key — set one of the following:
CLAUDE_API_KEY=
GEMINI_API_KEY=

# LLM model selection (optional — defaults differ by provider)
GEMINI_LLM_MODEL=
CLAUDE_MODEL=

# Path to the MXDR analysis agent root directory
# (Inherits from PROJECTS_ROOT if not set)
MXDR_AGENT_ROOT=...\MXDR_analysis_agent

# Verbose mode (optional, 1=true, 0=false)
VERBOSE=0
